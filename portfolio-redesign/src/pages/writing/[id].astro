---
import { getCollection } from 'astro:content';
import { dateLabel, writingArticle } from '../../entries';
import Page from '../../layouts/Page.astro';
export async function getStaticPaths() {
  return (await getCollection('writing')).map(entry => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { title, summary, topic, date, Content } = await writingArticle(entry);
---
<Page title={title} description={summary || title} section="writing" article={true}>
  <article class="reading">
    <a class="back" href="/writing/">All writing</a>
    <header class="article-head">
      {topic && <p class="entry-meta">{topic}</p>}
      <h1>{title}</h1>
      {entry.data.summary && <p class="standfirst">{entry.data.summary}</p>}
      <p class="tools">Rupesh Patel{date && ' · ' + dateLabel(date)}</p>
    </header>
    <div class="prose"><Content /></div>
  </article>
</Page>

---
import Page from '../layouts/Page.astro';
const resumePdf = '/resume.pdf';
---
<Page title="Résumé" section="resume" description="Preview Rupesh Patel’s data engineering résumé or download the PDF.">
  <section class="resume-page" aria-labelledby="resume-heading">
    <header class="resume-head">
      <div><h1 id="resume-heading">Résumé</h1><p>Rupesh Patel · Data Engineer</p></div>
      <div class="resume-actions"><a href={resumePdf} target="_blank" rel="noopener">Open PDF</a><a class="download" href={resumePdf} download="Rupesh-Patel-Resume.pdf">Download PDF</a></div>
    </header>
    <div class="resume-sheet">
      <object class="pdf-reader" data={resumePdf} type="application/pdf" aria-label="Rupesh Patel’s résumé PDF">
        <p class="resume-preview-status"><a href={resumePdf}>Open the résumé PDF</a></p>
      </object>
      <div class="mobile-sheet" data-resume-preview={resumePdf}>
        <p class="resume-preview-status" role="status"><a href={resumePdf}>Open the résumé PDF</a></p>
      </div>
    </div>
  </section>
</Page>

<script>
  import { setupMobilePreview } from '../resume-preview';

  const preview = document.querySelector<HTMLElement>('[data-resume-preview]');
  if (preview) setupMobilePreview(preview);
</script>

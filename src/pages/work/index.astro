---
import Page from '../../layouts/Page.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { selectedWork } from '../../entries';
const entries = await selectedWork();
---
<Page title="Selected work" section="work" description="Rupesh Patel’s data engineering case studies and a collaborative machine learning project at UBC.">
  <div class="work-index">
    <header class="page-head"><h1>Selected work</h1><p>Data engineering in practice and projects from my time at UBC.</p></header>
    <ProjectGrid entries={entries} heading="h2" showTools={false} />
  </div>
</Page>
